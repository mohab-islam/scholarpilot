# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# ---- AI: Gemini on Vertex AI --------------------------------------------------
# Locally, authenticate once with:  gcloud auth application-default login
# On a Google Cloud VM, the attached service account is used (needs "Vertex AI User").
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# ---- Hosted mode only (leave empty for local use) -----------------------------
# Setting APP_PASSWORD turns on the login page and locks every route behind it.
APP_PASSWORD=
# Long random string used to sign login cookies (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
# Token the Chrome extension sends (only /api/linkedin/ingest and /api/profile/import accept it).
EXTENSION_TOKEN=
# Public https URL of the deployment. Also enables the web OAuth flow for Gmail.
PUBLIC_URL=
# Comma-separated Host headers accepted besides localhost, e.g. scholarpilot.example.com
ALLOWED_HOSTS=
# Used by Caddy in docker-compose.prod.yml (same host as above, no scheme).
DOMAIN=
# Minutes between background Gmail checks; 0 disables the watcher.
WATCH_INTERVAL_MIN=0
# Hour (UTC) of the daily internet sweep for new scholarships (also changeable in the app).
DAILY_SWEEP_HOUR_UTC=5
